{
  "name": "rePub",
  "description": "Send web pages to your reMarkable as ePubs",
  "version": "6.0.0",
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "repub@j0rd1smit.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "notifications",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://webapp-prod.cloud.remarkable.engineering/",
    "https://storage.googleapis.com/",
    "https://eu.tectonic.remarkable.com/"
  ],
  "optional_host_permissions": ["https://*/"],
  "options_ui": {
    "page": "out/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "convert page to epub",
    "default_icon": {
      "16": "images/repub_16.png",
      "32": "images/repub_32.png",
      "48": "images/repub_48.png"
    }
  },
  "background": {
    "scripts": ["out/background.js"],
    "type": "module"
  },
  "icons": {
    "16": "images/repub_16.png",
    "32": "images/repub_32.png",
    "48": "images/repub_48.png",
    "128": "images/repub_128.png"
  }
}
